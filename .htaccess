Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<FilesMatch "^(README\.md|package(?:-lock)?\.json|\.env.*)$">
    Require all denied
</FilesMatch>

RewriteEngine On
# HTTPS is already enforced by the verified Hostinger edge configuration.
# Consolidate www without trusting client-supplied forwarding headers.
RewriteCond %{HTTP_HOST} ^www\.oyonx\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://oyonx.com%{REQUEST_URI} [R=301,L,NE]
# Hide generated-shell URLs from direct requests; internal rewrites still work.
RewriteCond %{THE_REQUEST} \s/+seo-pages/ [NC]
RewriteRule ^seo-pages/ - [F,L]
# Prefer the clean homepage over its physical filename.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
# Keep repository metadata and hidden configuration private; allow ACME challenges.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
# Existing files (including PHP and assets) must bypass the SPA fallback.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# OYONX ROUTES START
RewriteRule ^about/?$ /#about [R=301,L,NE]
RewriteRule ^services/?$ /#services [R=301,L,NE]
RewriteRule ^portfolio/?$ /#portfolio [R=301,L,NE]
RewriteRule ^plans/?$ /#plans [R=301,L,NE]
RewriteRule ^contact/?$ /#contact [R=301,L,NE]
RewriteRule ^studio/?$ /about-us [R=301,L]
RewriteRule ^services/ui-ux/$ /services/ui-ux [R=301,L]
RewriteRule ^services/ui-ux$ seo-pages/services--ui-ux.html [L]
RewriteRule ^services/development/$ /services/development [R=301,L]
RewriteRule ^services/development$ seo-pages/services--development.html [L]
RewriteRule ^services/marketing/$ /services/marketing [R=301,L]
RewriteRule ^services/marketing$ seo-pages/services--marketing.html [L]
RewriteRule ^about-us/$ /about-us [R=301,L]
RewriteRule ^about-us$ seo-pages/about-us.html [L]
RewriteRule ^contact-us/$ /contact-us [R=301,L]
RewriteRule ^contact-us$ seo-pages/contact-us.html [L]
RewriteRule ^blog/$ /blog [R=301,L]
RewriteRule ^blog$ seo-pages/blog.html [L]
RewriteRule ^blog/website-cost-dubai-2025/$ /blog/website-cost-dubai-2025 [R=301,L]
RewriteRule ^blog/website-cost-dubai-2025$ seo-pages/blog--website-cost-dubai-2025.html [L]
RewriteRule ^blog/ui-ux-design-mistakes/$ /blog/ui-ux-design-mistakes [R=301,L]
RewriteRule ^blog/ui-ux-design-mistakes$ seo-pages/blog--ui-ux-design-mistakes.html [L]
RewriteRule ^blog/web-development-agency-uae/$ /blog/web-development-agency-uae [R=301,L]
RewriteRule ^blog/web-development-agency-uae$ seo-pages/blog--web-development-agency-uae.html [L]
RewriteRule ^blog/digital-marketing-dubai-2025/$ /blog/digital-marketing-dubai-2025 [R=301,L]
RewriteRule ^blog/digital-marketing-dubai-2025$ seo-pages/blog--digital-marketing-dubai-2025.html [L]
RewriteRule ^blog/what-is-a-design-system/$ /blog/what-is-a-design-system [R=301,L]
RewriteRule ^blog/what-is-a-design-system$ seo-pages/blog--what-is-a-design-system.html [L]
RewriteRule ^plugins/$ /plugins [R=301,L]
RewriteRule ^plugins$ seo-pages/plugins.html [L]
RewriteRule ^$ index.html [L]
# OYONX ROUTES END
# Never return the homepage for unknown routes or missing files.
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
    <FilesMatch "\.(?:html|xml|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
